# nyarch-lightweight build configuration
# The lite shell has NO frontend build, so it needs no Supabase/VAPID keys.
# It only needs the live site URL, baked into the Rust binary at compile time.
#
# Local build:  export NYARCH_URL=https://your-site  &&  npm run tauri build
# CI build:     set NYARCH_URL as a GitHub Actions repo variable or secret.

NYARCH_URL=https://nyarch.example.com
