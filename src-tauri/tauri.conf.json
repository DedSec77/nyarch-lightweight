{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nyarch-lightweight",
  "version": "0.1.0",
  "identifier": "com.nyarch.lightweight",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Lightweight nyarch desktop shell",
    "longDescription": "A tiny desktop wrapper that opens the live nyarch site in a native window with a background tray. No bundled frontend — always up to date."
  }
}
